# Imagem dos binários Go (api, worker, migrate). Selecione com --build-arg CMD.
# Versões fixadas; os digests usados em cada entrega ficam em
# docs/operacao/imagens-base.md.
ARG GO_VERSION=1.27.3
ARG ALPINE_VERSION=3.22

FROM golang:${GO_VERSION}-alpine AS base
# git: clonar, abrir e criar repositórios dos projetos (ADR-0061).
RUN apk add --no-cache git
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download

# Desenvolvimento: hot reload com air; o código vem de bind mount.
FROM base AS dev
# docker-cli: o worker de desenvolvimento roda o login das contas de IA em containers (ADR-0065).
RUN apk add --no-cache docker-cli
RUN go install github.com/air-verse/air@v1.62.0
ENV GOFLAGS=

FROM base AS build
ARG CMD
COPY . .
RUN go build -ldflags="-s -w" -o /out/app ./cmd/${CMD}

FROM alpine:${ALPINE_VERSION} AS runtime
RUN apk add --no-cache git && adduser -D -H -u 10001 app \
 && mkdir /workspaces && chown 10001:10001 /workspaces
COPY --from=build /out/app /app/app
USER 10001:10001
ENTRYPOINT ["/app/app"]

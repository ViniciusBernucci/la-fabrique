# Imagem dos binários Go (api, worker, migrate). Selecione com --build-arg CMD.
# Versões fixadas; os digests usados em cada entrega ficam em
# docs/operacao/imagens-base.md.
ARG GO_VERSION=1.27.3
ARG ALPINE_VERSION=3.22

FROM golang:${GO_VERSION}-alpine AS base
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download

# Desenvolvimento: hot reload com air; o código vem de bind mount.
FROM base AS dev
RUN go install github.com/air-verse/air@v1.62.0
ENV GOFLAGS=

FROM base AS build
ARG CMD
COPY . .
RUN go build -ldflags="-s -w" -o /out/app ./cmd/${CMD}

FROM alpine:${ALPINE_VERSION} AS runtime
RUN adduser -D -H -u 10001 app
COPY --from=build /out/app /app/app
USER 10001:10001
ENTRYPOINT ["/app/app"]

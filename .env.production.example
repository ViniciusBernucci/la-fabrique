# Modelo para a VPS. Copie para .env NA VPS (fora do Git) e preencha.
COMPOSE_PROJECT_NAME=le-fabrique
APP_ENV=production
LOG_LEVEL=info

# Só o web é publicado. Mantenha em loopback se um proxy TLS do host fica na
# frente (recomendado); use 0.0.0.0 apenas conscientemente.
WEB_BIND=127.0.0.1
WEB_PORT=8280

POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
# Obrigatório. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

DEV_AUTH_ENABLED=false
SESSION_COOKIE_SECURE=true

LIMIT_POSTGRES_MEM=1g
LIMIT_API_MEM=512m
LIMIT_WORKER_MEM=1g
LIMIT_WEB_MEM=128m

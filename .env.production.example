# Modelo para a VPS. Copie para .env NA VPS (fora do Git) e preencha.
COMPOSE_PROJECT_NAME=le-fabrique
APP_ENV=production
LOG_LEVEL=info

# Só o web é publicado. Mantenha em loopback se um proxy TLS do host fica na
# frente (recomendado); use 0.0.0.0 apenas conscientemente.
WEB_BIND=127.0.0.1
WEB_PORT=8280

POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
# Obrigatório. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

SESSION_COOKIE_SECURE=true
# A API recusa requisições sem X-Forwarded-Proto=https e envia HSTS. (Padrão em produção.)
REQUIRE_HTTPS=true

# Obrigatório. Chave AES-256 do cofre e do TOTP: gere com `openssl rand -base64 32`,
# guarde uma cópia FORA do servidor e do backup do banco. Sem ela os segredos
# cifrados e o 2FA não podem ser lidos (ver docs/operacao/backup-restauracao.md).
VAULT_KEY=
VAULT_KEY_ID=k1

LIMIT_POSTGRES_MEM=1g
LIMIT_API_MEM=512m
LIMIT_WORKER_MEM=1g
LIMIT_WEB_MEM=128m

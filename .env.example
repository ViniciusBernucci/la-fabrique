# Copie para .env (ignorado pelo Git) e ajuste. NUNCA commite segredos reais.
# Em dev local os valores abaixo funcionam como estão; na VPS troque as senhas
# (ex.: `openssl rand -hex 24`, que evita caracteres especiais na URL do banco).

# Nome do projeto Compose. Use outro nome por ambiente (ex.: le-fabrique-hml)
# para que volumes e redes nunca sejam compartilhados entre ambientes.
COMPOSE_PROJECT_NAME=le-fabrique-dev

# development | test | production
APP_ENV=development
LOG_LEVEL=info

# Portas no host. As padrão (5173 web, 5432 Postgres) já estão em uso nesta
# máquina, por isso o projeto usa faixas próprias. Tudo é configurável.
WEB_PORT=5180
API_PORT=8480
POSTGRES_PORT=5442
# Em dev as portas são publicadas só em loopback. Na VPS, use WEB_BIND=127.0.0.1
# (proxy TLS do host na frente) ou 0.0.0.0 apenas se for expor direto.
WEB_BIND=127.0.0.1

# PostgreSQL (container). Dev: senha de exemplo. Produção: gere uma nova.
POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
POSTGRES_PASSWORD=le_fabrique_dev_only

# Login: crie a conta com `make create-admin` e cadastre o 2FA no primeiro acesso.
# (O acesso dev sem senha foi removido no T04-01; DEV_AUTH_ENABLED é recusada.)
SESSION_COOKIE_SECURE=false

# Chave AES-256 (base64 de 32 bytes) que cifra o cofre de conexões e o segredo
# TOTP. Fica FORA do banco. Gere a sua: openssl rand -base64 32
# O valor abaixo é público e serve SÓ para dev descartável; nunca use na VPS.
VAULT_KEY=ZGV2LW9ubHktdmF1bHQta2V5LW5ldmVyLXByb2QhISE=
VAULT_KEY_ID=k1

# Tarefas periódicas do worker (opcionais; valores padrão abaixo).
# WORKER_JOBS_INTERVAL=30s     liberar itens cuja decisão foi resolvida e recuperar tentativas interrompidas
# RETENTION_INTERVAL=24h       frequência da retenção
# RETENTION_APPLY=false        false = só simula e registra; true = remove logs e checkpoints vencidos

# Limites iniciais NÃO MEDIDOS (T02-01 pendente). Ajuste após o benchmark da VPS.
LIMIT_POSTGRES_MEM=1g
LIMIT_API_MEM=512m
LIMIT_WORKER_MEM=1g
LIMIT_WEB_MEM=128m

# Sentinela: sync matinal das Issues pelo worker (desligado por padrão; exige VAULT_KEY no worker)
# SENTINEL_ISSUE_SYNC=true
# ISSUE_SYNC_HOUR=7
# ISSUE_SYNC_TZ=America/Sao_Paulo
# CORRECTIONS_POLL_INTERVAL=5m
# Sentinela: consulta das PRs gerenciadas no GitHub (agenda própria; desligada por padrão; exige VAULT_KEY no worker)
# SENTINEL_PR_SYNC=true
# PR_POLL_INTERVAL=3m
# Sentinela: laço de admissão (por evento e por varredura). Sem executor ligado roda em observação (dry-run): audita, não admite.
# SENTINEL_ADMISSION=true
# ADMISSION_INTERVAL=15s
# PLANNING_SLOTS=1

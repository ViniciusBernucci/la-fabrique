# Copie para .env (ignorado pelo Git) e ajuste. NUNCA commite segredos reais.
# Em dev local os valores abaixo funcionam como estão; na VPS troque as senhas
# (ex.: `openssl rand -hex 24`, que evita caracteres especiais na URL do banco).

# Nome do projeto Compose. Use outro nome por ambiente (ex.: le-fabrique-hml)
# para que volumes e redes nunca sejam compartilhados entre ambientes.
COMPOSE_PROJECT_NAME=le-fabrique-dev

# development | test | production
APP_ENV=development
LOG_LEVEL=info

# Portas no host. As padrão (5173 web, 5432 Postgres) já estão em uso nesta
# máquina, por isso o projeto usa faixas próprias. Tudo é configurável.
WEB_PORT=5180
API_PORT=8480
POSTGRES_PORT=5442
# Em dev as portas são publicadas só em loopback. Na VPS, use WEB_BIND=127.0.0.1
# (proxy TLS do host na frente) ou 0.0.0.0 apenas se for expor direto.
WEB_BIND=127.0.0.1

# PostgreSQL (container). Dev: senha de exemplo. Produção: gere uma nova.
POSTGRES_DB=le_fabrique
POSTGRES_USER=le_fabrique
POSTGRES_PASSWORD=le_fabrique_dev_only

# Login real chega no T04-01. Em dev, habilita o botão "Entrar (dev)".
# O backend recusa DEV_AUTH_ENABLED=true fora de APP_ENV=development.
DEV_AUTH_ENABLED=true
SESSION_COOKIE_SECURE=false

# Limites iniciais NÃO MEDIDOS (T02-01 pendente). Ajuste após o benchmark da VPS.
LIMIT_POSTGRES_MEM=1g
LIMIT_API_MEM=512m
LIMIT_WORKER_MEM=1g
LIMIT_WEB_MEM=128m
